// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  name        String?
  email       String   @unique
  password    String?   // nullable désormais
  authMethod  String?   // 'CREDENTIALS' | 'GOOGLE' — null tant que non activé
  status      String    @default("PENDING") // PENDING, ACTIVE
  role        String   @default("RECEPTIONIST") // ADMIN, DG, RECEPTIONIST
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  entries        Entry[]
  payments       Payment[]
  cashMovements  CashMovement[]
  stockMovements StockMovement[]
  validations    Closure[] @relation("ClosureValidator")
  activationTokens ActivationToken[]
  passwordResetTokens PasswordResetToken[]
}

model ActivationToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique   // sha256 du vrai token, jamais le token en clair en base
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Room {
  id           String   @id @default(cuid())
  num          String   @unique
  type         String   // V (Ventilée), C (Climée), A (Appart)
  label        String
  priceHourly  Float    @default(0) // tarif à l'heure
  priceNightly Float    @default(0) // tarif à la nuitée
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String   @default("DRINK") // DRINK, CONDOM
  price     Float
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  entries   EntryProduct[]
  movements StockMovement[]
}

model Entry {
  id           String   @id @default(cuid())
  receiptNo    String?
  roomNum      String
  roomType     String
  roomTypeLabel String
  stayType     String   @default("HORAIRE") // HORAIRE | NUITEE
  arrival      String?
  departure    String?
  duration     String?
  roomAmount   Float    @default(0)
  condomAmount Float    @default(0)
  drinksAmount Float    @default(0)
  total        Float    @default(0)
  
  date         String   // YYYY-MM-DD — jour d'arrivée, pour affichage uniquement
  
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products     EntryProduct[]
  payments     Payment[]
}

model EntryProduct {
  id        String @id @default(cuid())
  qty       Int
  price     Float
  
  entryId   String
  entry     Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  
  productId String
  product   Product  @relation(fields: [productId], references: [id])
}

/// Historique des encaissements réels. Source de vérité des bilans — pas
/// Entry.total (qui n'est qu'une estimation tant que le séjour n'est pas
/// soldé). `date` est TOUJOURS fixée par le serveur à la date du jour au
/// moment de la création (jamais fournie par le client) : c'est ce qui
/// garantit que les bilans des jours passés ne changent plus jamais.
model Payment {
  id        String   @id @default(cuid())
  amount    Float
  date      String   // YYYY-MM-DD — jour où l'argent a réellement été pris

  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model CashMovement {
  id        String   @id @default(cuid())
  label     String
  amount    Float
  type      String   // 'depense' or 'recette'
  date      String   // YYYY-MM-DD
  
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockMovement {
  id        String   @id @default(cuid())
  type      String   // 'IN' or 'OUT'
  qty       Int
  price     Float?
  motif     String?  // Obligatoire pour 'OUT'
  date      String   // YYYY-MM-DD
  
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Bilan GLOBAL (toute l'équipe confondue) pour un jour ou une semaine.
/// Ne stocke plus les montants calculés au quotidien — ceux-ci sont
/// toujours recalculés en direct depuis Payment/CashMovement/Entry pour la
/// date/période demandée (lib/closures.ts). Ce modèle ne conserve que
/// l'ACTE humain de validation : le montant réellement remis et par qui.
/// `expectedAmount` est un instantané du montant attendu AU MOMENT de la
/// validation, à des fins d'audit uniquement (jamais recalculé après coup).
model Closure {
  id             String   @id @default(cuid())
  date           String   // YYYY-MM-DD (DAILY) ou YYYY-Www (WEEKLY)
  type           String   // 'DAILY' or 'WEEKLY'

  expectedAmount Float
  handedAmount   Float?
  discrepancy    Float?
  comments       String?
  status         String   @default("PENDING") // PENDING, VALIDATED

  validatedById  String?
  validatedBy    User?    @relation("ClosureValidator", fields: [validatedById], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([date, type])
}

model OtpCode {
  id         String    @id @default(cuid())
  email      String
  code       String
  purpose    String    // 'LOGIN' or 'SIGNUP'
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model AccessRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // 'CREATE_ENTRY', 'UPDATE_ENTRY', 'DELETE_ENTRY'
  entityId  String
  details   String
  userId    String
  createdAt DateTime @default(now())
}